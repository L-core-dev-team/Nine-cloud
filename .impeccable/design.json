  "narrative": {
    "northStar": "月下入界山门",
    "overview": "夜山不是背景装饰，而是持续存在的世界画布。月、雾、山、水、梅和朱印构成视觉语法。界面只在玩家需要行动时显形。清透玉玻璃用于导航、按钮和输入；高不透明烟纱用于剧情、表单和资料。系统追求克制的仪式感。首屏允许一个明确的入界时刻。进入游戏后，视觉重心立即转向阅读和行动。长时界面不使用持续炫光、逐字打字机或大面积折射。",
    "keyCharacteristics": [
      "深蓝黑夜山承担主要氛围，月白承担正文和题字。",
      "桃粉只用于细微光感、焦点和边界；朱红只作为印记。",
      "控件通透，内容稳定；材质强度服从任务时长。",
      "所有效果都具有无动效、无透明和低性能回退。"
    ],
    "rules": [
      {"name": "The Rare Accent Rule", "body": "桃粉和朱红不承担大面积背景。任何单屏都应以夜色和月白为主。", "section": "colors"},
      {"name": "The Three Voices Rule", "body": "题字、正文和操作各用一种文字声音；不要把楷体铺到设置表单，也不要用无衬线替代剧情正文。", "section": "typography"},
      {"name": "The Content Stability Rule", "body": "动态高光只属于交互 chrome。剧情、资料和表单不能因指针位置产生形变。", "section": "elevation"}
    ],
    "dos": [
      "Do 把透明度与动效当作渐进增强，确保实色回退仍能完成任务。",
      "Do 为长文保留宋体、宽松行距和稳定背景。",
      "Do 在手机上优先保证安全区、键盘、滚动和 44px 触控目标。",
      "Do 使用自绘 SVG 或 CSS 图形维持同一图标语言。"
    ],
    "donts": [
      "Don't 把液态玻璃铺进剧情正文、世界资料或长表单。",
      "Don't 使用满屏常驻粒子、循环彩虹、逐字打字机、自定义鼠标或滚动劫持。",
      "Don't 虚构地点、存档、账号、云同步或商业能力来填充界面。",
      "Don't 把 Apple、Huawei、Claude 或开源演示的品牌外观直接复制为《九霄》的身份。"
    ]
  }
