+'use strict';
+const fs=require('node:fs'),path=require('node:path'),{spawnSync}=require('node:child_process'),z=require('node:zlib');
+const root=__dirname,old=path.resolve(root,'../p6-longmem-06'),name=process.argv[2];if(!name||!/^[a-z0-9-]+$/.test(name))throw Error('New run name');
+const out=path.join(root,'evidence',name);fs.mkdirSync(out);const rows=[];
+const jobs=[{kind:'05c-public',suite:'holdout',count:10000,data:path.resolve(root,'../p6-longmem-05c/fixtures/holdout-10000-dataset.json.gz'),questions:path.resolve(root,'../p6-longmem-05c/fixtures/holdout-10000-questions.json.gz')},...['complex','prose'].flatMap(kind=>[1000,10000].map(count=>({kind,count})))];
+for(const job of jobs){const output=path.join(out,`${job.kind}-${job.count}`);fs.mkdirSync(output);const file=path.join(output,'config.json');fs.writeFileSync(file,JSON.stringify({...job,mode:'sufficient',output}));const r=spawnSync(process.execPath,['--max-old-space-size=1536',path.join(old,'evaluate-worker.ts'),file],{encoding:'utf8',windowsHide:true,timeout:600000,maxBuffer:16*1024*1024});fs.writeFileSync(path.join(output,'run.log'),(r.stdout??'')+(r.stderr??'')+(r.error?.stack??''));if(r.status!==0)throw Error('Regression process failed');const s=JSON.parse(fs.readFileSync(path.join(output,'summary.json')));rows.push(s);console.log(JSON.stringify({kind:s.kind,count:s.count,...s.metrics}));}
+const current=JSON.parse(z.gunzipSync(fs.readFileSync(path.join(out,'05c-public-10000/queries.json.gz'))));const previous=JSON.parse(z.gunzipSync(fs.readFileSync(path.join(old,'evidence/curated-public-01/05c-public-holdout-10000-sufficient/queries.json.gz'))));
+const oldRows=new Map(previous.map(r=>[r.questionId+':'+r.budget,r]));const differing=current.filter(r=>{const p=oldRows.get(r.questionId+':'+r.budget);return !p||r.pass!==p.pass||r.result.enoughEvidence!==p.result.enoughEvidence||JSON.stringify(r.actual)!==JSON.stringify(p.actual)||JSON.stringify(r.result.originalSpans)!==JSON.stringify(p.result.originalSpans);});
+fs.writeFileSync(path.join(out,'comparison.json'),JSON.stringify({compared:current.length,differing:differing.length,target:current.filter(r=>r.questionId==='holdout:2:consumed:52'),categoryMetrics:rows[0].byCategory},null,2));fs.writeFileSync(path.join(out,'summary.json'),JSON.stringify(rows,null,2));if(differing.length)throw Error('Unexpected baseline difference');
