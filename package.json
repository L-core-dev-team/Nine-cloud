{
  "name": "jiuxiao-workspace",
  "private": true,
  "version": "1.0.0-alpha.0",
  "packageManager": "pnpm@11.19.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev:web": "pnpm --filter @jiuxiao/contracts build && pnpm --filter @jiuxiao/web dev",
    "dev:api": "pnpm --filter @jiuxiao/contracts build && pnpm --filter @jiuxiao/api dev",
    "typecheck": "pnpm --filter @jiuxiao/contracts build && pnpm -r typecheck",
    "test": "node work/core-regression.cjs && pnpm -r test",
    "build": "pnpm -r build && node scripts/build/write-manifest.mjs --stage S2",
    "test:integration": "pnpm --filter @jiuxiao/api test:integration",
    "test:e2e": "node tests/e2e/foundation.cjs",
    "license:check": "node scripts/audit/license-check.mjs"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "playwright": "1.63.0",
    "typescript": "6.0.2",
    "vitest": "5.0.1"
  }
}
