POSTGRES_PASSWORD=replace-with-a-local-random-secret
DATABASE_URL=postgresql://jiuxiao:replace-with-a-local-random-secret@127.0.0.1:5433/jiuxiao
API_PORT=8787
API_HOST=127.0.0.1
WEB_PORT=5173

# S6 is opt-in; use an HTTPS same-origin reverse proxy outside loopback development.
AUTH_ENABLED=false
# Optional startup SMTP connection/auth check; does not prove inbox delivery.
AUTH_MAIL_PREFLIGHT=false
AUTH_PUBLIC_ORIGIN=http://127.0.0.1:5173
# Strict for same-site custom domains. None requires HTTPS and browser third-party cookies.
AUTH_COOKIE_SAME_SITE=Strict
AUTH_SECRET=
AUTH_MAIL_FROM=login@example.invalid
# Production: smtp://user:URL-encoded-password@host:587 or smtps://user:URL-encoded-password@host:465
SMTP_URL=smtp://127.0.0.1:1025

# Set only to a host-approved policy version. Empty keeps closure/deletion closed.
ACCOUNT_DATA_POLICY_VERSION=
ACCOUNT_DELETE_ENABLED=false
