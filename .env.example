POSTGRES_PASSWORD=replace-with-a-local-random-secret
DATABASE_URL=postgresql://jiuxiao:replace-with-a-local-random-secret@127.0.0.1:5433/jiuxiao
API_PORT=8787
API_HOST=127.0.0.1
WEB_PORT=5173

# S6 is opt-in; use an HTTPS same-origin reverse proxy outside loopback development.
AUTH_ENABLED=false
# Supabase Auth mode is mutually exclusive with AUTH_ENABLED. The Node/Hono API still owns
# the opaque session cookie, stable auth_accounts owner ID, account lifecycle and cloud APIs.
SUPABASE_AUTH_ENABLED=false
SUPABASE_AUTH_EMAIL_ENABLED=false
SUPABASE_AUTH_PHONE_ENABLED=false
SUPABASE_URL=https://deyzirwnzjxsmyvfrsdb.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Secret key (or legacy service_role key) is server-only; never expose it to Vite, Pages, or clients.
SUPABASE_SECRET_KEY=
# Exact direct peer IPs of the trusted reverse proxy; phone SMS remains disabled without this.
AUTH_TRUSTED_PROXY_ADDRESSES=
# Long-lived independent HMAC key for identity/IP digests. Rotating it requires a planned data migration.
AUTH_IDENTITY_HMAC_SECRET=
# Set these two assertions only after configuring the Auth Send SMS hook and CAPTCHA in Supabase.
SUPABASE_PHONE_HOOK_CONFIGURED=false
SUPABASE_PHONE_CAPTCHA_CONFIGURED=false
# CNY fen/segments. Default zero keeps SMS disabled. Mirror the values in the Supabase Edge Function secrets.
SMS_ESTIMATED_SEGMENT_COST_CENTS=0
SMS_MAX_SEGMENTS_PER_SEND=0
SMS_MONTHLY_BUDGET_CENTS=0
SMS_MONTHLY_MAX_SEGMENTS=0
SMS_DAILY_MAX_SEGMENTS=0
SMS_PHONE_HOURLY_LIMIT=0
SMS_PHONE_DAILY_LIMIT=0
SMS_IP_HOURLY_LIMIT=0
SMS_IP_DAILY_LIMIT=0
SMS_OWNER_HOURLY_LIMIT=0
SMS_OWNER_DAILY_LIMIT=0
SMS_ALLOWED_COUNTRY_PREFIXES=
# Vite deployment variable: VITE_TURNSTILE_SITE_KEY (public site key only; never put the Turnstile secret here).
# Optional startup SMTP connection/auth check; does not prove inbox delivery.
AUTH_MAIL_PREFLIGHT=false
AUTH_PUBLIC_ORIGIN=http://127.0.0.1:5173
AUTH_PRIVACY_POLICY_URL=
AUTH_PRIVACY_POLICY_VERSION=
# Strict for same-site custom domains. None requires HTTPS and browser third-party cookies.
AUTH_COOKIE_SAME_SITE=Strict
AUTH_SECRET=
AUTH_MAIL_FROM=login@example.invalid
# Production: smtp://user:URL-encoded-password@host:587 or smtps://user:URL-encoded-password@host:465
SMTP_URL=smtp://127.0.0.1:1025

# Set only to a host-approved policy version. Empty keeps closure/deletion closed.
ACCOUNT_DATA_POLICY_VERSION=
ACCOUNT_DELETE_ENABLED=false

# Host-installed author-reviewed rule module; absent remains RULES_NOT_READY.
TURN_RULES_MODULE=
NARRATIVE_CONFIG_PATH=
NARRATIVE_OUTPUT_BUDGET=32768

# Private approved data policy JSON; production does not accept a version label as approval
ACCOUNT_DATA_POLICY_PATH=
