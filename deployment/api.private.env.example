# Copy privately to api.private.env. Do not commit actual values.
# Supply API_IMAGE by exact tested digest in the host's Compose environment.
API_IMAGE=
PUBLIC_API_BASE_URL=
DATABASE_URL=
# Keep exactly one auth mode enabled. Both are disabled by default.
AUTH_ENABLED=false
SUPABASE_AUTH_ENABLED=false
SUPABASE_AUTH_EMAIL_ENABLED=false
SUPABASE_AUTH_PHONE_ENABLED=false
SUPABASE_URL=https://deyzirwnzjxsmyvfrsdb.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Supabase secret key (sb_secret_...) or legacy service_role key. Server-only.
SUPABASE_SECRET_KEY=
AUTH_IDENTITY_HMAC_SECRET=
# Exact direct peer IPs of the trusted reverse proxy. Phone SMS remains off until configured.
AUTH_TRUSTED_PROXY_ADDRESSES=
SUPABASE_PHONE_HOOK_CONFIGURED=false
SUPABASE_PHONE_CAPTCHA_CONFIGURED=false
# SMS remains stopped at ¥0 until all limits and provider approvals are verified.
SMS_ESTIMATED_SEGMENT_COST_CENTS=0
SMS_MAX_SEGMENTS_PER_SEND=0
SMS_MONTHLY_BUDGET_CENTS=0
SMS_MONTHLY_MAX_SEGMENTS=0
SMS_DAILY_MAX_SEGMENTS=0
SMS_PHONE_HOURLY_LIMIT=0
SMS_PHONE_DAILY_LIMIT=0
SMS_IP_HOURLY_LIMIT=0
SMS_IP_DAILY_LIMIT=0
SMS_OWNER_HOURLY_LIMIT=0
SMS_OWNER_DAILY_LIMIT=0
SMS_ALLOWED_COUNTRY_PREFIXES=
AUTH_PUBLIC_ORIGIN=
AUTH_SECRET=
AUTH_MAIL_FROM=
# 发信通道：ses-api（腾讯云 API，个人认证可用，默认）| smtp（SMTP 协议）
# 依据：腾讯云自 2026-03-02 起，个人实名认证用户不再支持 SMTP 发信
# https://cloud.tencent.com/announce/detail/2212
AUTH_MAILER=ses-api
# ses-api 通道凭证（控制台 → 访问管理 → API 密钥管理）。属服务端密钥，绝不可入库。
TENCENT_SES_SECRET_ID=
TENCENT_SES_SECRET_KEY=
# Region：国内站支持 ap-guangzhou 与 ap-hongkong
TENCENT_SES_REGION=ap-guangzhou
# 仅 AUTH_MAILER=smtp 时需要 SMTP_URL（企业认证或 2026-03-02 前开通的个人用户）
SMTP_URL=
AUTH_MAIL_PREFLIGHT=true
AUTH_COOKIE_SAME_SITE=Strict
ACCOUNT_DATA_POLICY_VERSION=
ACCOUNT_DELETE_ENABLED=false
# 公开隐私政策地址与版本。生产环境（NODE_ENV=production）下两项均必填，
# 缺失或格式非法时认证运行时 fail-closed 拒绝启动，不允许无声明地采集个人信息。
# 页面位于 apps/web/public/privacy/index.html，随前端构建一并发布。
AUTH_PRIVACY_POLICY_URL=https://jiuxiaogame.cn/privacy
AUTH_PRIVACY_POLICY_VERSION=1.0
# Optional author-approved module and provider configuration inside the read-only mount.
TURN_RULES_MODULE=
NARRATIVE_CONFIG_PATH=
NARRATIVE_OUTPUT_BUDGET=32768
NARRATIVE_KEY_STORY=

ACCOUNT_DATA_POLICY_PATH=
