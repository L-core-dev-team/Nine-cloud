{
  "name": "@jiuxiao/content",
  "version": "1.0.0-alpha.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./realm-order": {
      "types": "./dist/realm-order.d.ts",
      "default": "./dist/realm-order.js"
    },
    "./canon-artifact": {
      "types": "./dist/canon-artifact.d.ts",
      "default": "./dist/canon-artifact.js"
    },
    "./p1-review-candidate": {
      "types": "./dist/p1-review-candidate.d.ts",
      "default": "./dist/p1-review-candidate.js"
    },
    "./scenes": {
      "types": "./dist/scenes/manifest.d.ts",
      "default": "./dist/scenes/manifest.js"
    },
    "./worldbook": {
      "types": "./dist/worldbook.d.ts",
      "default": "./dist/worldbook.js"
    },
    "./publisher": {
      "types": "./dist/worldbook-publisher.d.ts",
      "default": "./dist/worldbook-publisher.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src"
  },
  "devDependencies": {
    "@types/node": "26.6.5"
  }
}
