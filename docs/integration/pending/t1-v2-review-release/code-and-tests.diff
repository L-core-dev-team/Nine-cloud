diff --git a/docs/integration/pending/0023_narrative_ownership_v2.sql b/docs/integration/pending/0023_narrative_ownership_v2.sql
new file mode 100644
index 0000000..38b9e33
--- /dev/null
+++ b/docs/integration/pending/0023_narrative_ownership_v2.sql
@@ -0,0 +1,63 @@
+-- REVIEW PROPOSAL ONLY. Not registered in Drizzle journal, never executed by this task.
+-- Run only after separately approved migration, lifecycle/export and fleet cutover review.
+CREATE TABLE narrative_writer_fence (
+ singleton boolean PRIMARY KEY CHECK(singleton), protocol_version integer NOT NULL CHECK(protocol_version=2),
+ phase text NOT NULL CHECK(phase IN ('fenced','managed')), fleet_manifest_sha text NOT NULL,
+ renderer_version text NOT NULL CHECK(length(renderer_version)>0),
+ old_writer_drained boolean NOT NULL DEFAULT false, old_role_revoked boolean NOT NULL DEFAULT false,
+ valid_until timestamptz NOT NULL
+);
+-- Deliberately no enabled row. The application role must have SELECT only, no gate write rights.
+CREATE TABLE narrative_receipt_ownership (
+ owner_id text NOT NULL REFERENCES auth_accounts(id) ON DELETE CASCADE,
+ save_id text NOT NULL, request_key text NOT NULL, receipt_sha text NOT NULL CHECK(receipt_sha ~ '^[a-f0-9]{64}$'),
+ protocol_version integer NOT NULL CHECK(protocol_version IN (1,2)),
+ ownership text NOT NULL CHECK(ownership IN ('managed','suppressed','legacy')),
+ request_narrative boolean NOT NULL, renderer_version text NOT NULL, context_version text NOT NULL,
+ branch_id text NOT NULL CHECK(branch_id='root'), generation_id uuid REFERENCES narrative_generation_requests(id)
+ DEFERRABLE INITIALLY DEFERRED,
+ legacy_inventory_sha text, legacy_body bytea, legacy_body_sha text,
+ legacy_generator_source text CHECK(legacy_generator_source IN ('model','deterministic')),
+ PRIMARY KEY(save_id,request_key), UNIQUE(owner_id,save_id,request_key,receipt_sha),
+ FOREIGN KEY(save_id,request_key) REFERENCES turn_requests(save_id,idempotency_key) ON DELETE CASCADE,
+ CHECK ((ownership='managed' AND request_narrative AND protocol_version=2)
+   OR (ownership='suppressed' AND NOT request_narrative AND protocol_version=2 AND generation_id IS NULL)
+   OR (ownership='legacy' AND protocol_version=1 AND generation_id IS NULL AND legacy_inventory_sha IS NOT NULL AND legacy_inventory_sha ~ '^[a-f0-9]{64}$')),
+ CHECK(ownership='legacy' OR (legacy_body IS NULL AND legacy_body_sha IS NULL AND legacy_inventory_sha IS NULL AND legacy_generator_source IS NULL)),
+ CHECK((legacy_body IS NULL AND legacy_body_sha IS NULL) OR
+   (legacy_body IS NOT NULL AND legacy_body_sha IS NOT NULL AND legacy_generator_source IS NOT NULL AND legacy_body_sha=encode(sha256(legacy_body),'hex')))
+);
+CREATE FUNCTION verify_narrative_ownership_v2() RETURNS trigger LANGUAGE plpgsql AS $$
+DECLARE o narrative_receipt_ownership; BEGIN
+ SELECT * INTO o FROM narrative_receipt_ownership WHERE save_id=NEW.save_id AND request_key=NEW.request_key;
+ IF NOT FOUND THEN RETURN NULL; END IF;
+ IF NOT EXISTS(SELECT 1 FROM game_saves s JOIN turn_requests r ON r.save_id=s.id
+   WHERE s.id=o.save_id AND s.owner_id=o.owner_id AND r.idempotency_key=o.request_key
+   AND o.receipt_sha=encode(sha256(convert_to(r.result::text,'UTF8')),'hex')) THEN
+   RAISE EXCEPTION 'NARRATIVE_OWNERSHIP_IDENTITY_INVALID'; END IF;
+ IF o.ownership='managed' AND NOT EXISTS(
+   SELECT 1 FROM narrative_generation_requests g JOIN narrative_context_snapshots c ON c.id=g.context_id
+   WHERE g.id=o.generation_id AND g.save_id=o.save_id AND g.request_key=o.request_key
+   AND c.owner_id=o.owner_id AND c.receipt_sha=o.receipt_sha AND c.branch_id=o.branch_id
+   AND c.context->>'rendererVersion'=o.renderer_version AND c.context->>'format'=o.context_version) THEN
+   RAISE EXCEPTION 'NARRATIVE_MANAGED_INTEGRITY_FAILURE'; END IF;
+ IF o.ownership IN ('suppressed','legacy') AND EXISTS(SELECT 1 FROM narrative_generation_requests
+   WHERE save_id=o.save_id AND request_key=o.request_key) THEN RAISE EXCEPTION 'NARRATIVE_WRITER_CONFLICT'; END IF;
+ RETURN NULL; END $$;
+CREATE CONSTRAINT TRIGGER narrative_ownership_v2_complete AFTER INSERT OR UPDATE
+ ON narrative_receipt_ownership DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION verify_narrative_ownership_v2();
+CREATE FUNCTION protect_narrative_ownership_v2() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN
+ IF TG_OP='UPDATE' AND ((to_jsonb(NEW)-'generation_id') IS DISTINCT FROM (to_jsonb(OLD)-'generation_id')
+   OR OLD.generation_id IS NOT NULL OR NEW.generation_id IS NULL OR OLD.ownership<>'managed') THEN
+   RAISE EXCEPTION 'NARRATIVE_OWNERSHIP_IMMUTABLE'; END IF;
+ IF TG_OP='DELETE' AND coalesce(current_setting('jiuxiao.account_erasure_operation',true),'')='' THEN
+   RAISE EXCEPTION 'NARRATIVE_AUTHORIZED_ERASURE_REQUIRED'; END IF;
+ IF TG_OP='DELETE' THEN RETURN OLD; ELSE RETURN NEW; END IF;
+END $$;
+CREATE TRIGGER narrative_ownership_v2_immutable BEFORE UPDATE OR DELETE ON narrative_receipt_ownership
+ FOR EACH ROW EXECUTE FUNCTION protect_narrative_ownership_v2();
+-- Deployment role plan: application may SELECT/INSERT ownership, UPDATE(generation_id) only;
+-- no legacy import, gate writes, DDL, replication-role or trigger disable privileges.
+-- Legacy inventory importer must be a separate offline role, revoked before traffic opens.
+-- Gate updates require an operator role after externally verifying full fleet and draining ingress.
+-- No backfill based on missing G or timestamps. Legacy inventory import is an offline, separately reviewed step.
diff --git a/scripts/t1-v2-draft-tests.cjs b/scripts/t1-v2-draft-tests.cjs
new file mode 100644
index 0000000..ff5e638
--- /dev/null
+++ b/scripts/t1-v2-draft-tests.cjs
@@ -0,0 +1,75 @@
+'use strict';
+// Isolated unit fixtures. NOT real gameplay, NOT the official 16 acceptance cases.
+const {test}=require('node:test'),assert=require('node:assert/strict'),{pathToFileURL}=require('node:url'),path=require('node:path');
+const load=n=>import(pathToFileURL(path.resolve('apps/api/dist/services/'+n+'.js')).href);
+const receipt={saveId:'fixture-save',idempotencyKey:'11111111-1111-4111-8111-111111111111',requestFingerprint:'sha256:v1:'+'a'.repeat(64),
+  resultingRevision:1,decision:{status:'accepted',nextRevision:1,events:[]}};
+const sha='b'.repeat(64),sql=[];
+function fakeRead(ownership,generation){
+ const c={release(){},async query(q){sql.push(q);
+  if(q.includes('SELECT id FROM auth_accounts')||q.includes('SELECT id FROM game_saves'))return{rowCount:1,rows:[{id:'ok'}]};
+  if(q.includes('SELECT result,encode'))return{rowCount:1,rows:[{result:receipt,sha}]};
+  if(q.includes('SELECT * FROM narrative_receipt_ownership'))return{rowCount:ownership?1:0,rows:ownership?[{owner_id:'owner',receipt_sha:sha,branch_id:'root',protocol_version:2,renderer_version:'fixed-v1',context_version:'authority-context-v1',...ownership}]:[]};
+  if(q.includes('JOIN LATERAL'))return{rowCount:generation?1:0,rows:generation?[generation]:[]};
+  return{rowCount:0,rows:[]};
+ }};return{connect:async()=>c};
+}
+test('suppressed receipt returns not_requested without worker or generation reads',async()=>{
+ const {createNarrativeV2Port}=await load('narrative-ownership-v2');sql.length=0;
+ const port=createNarrativeV2Port(fakeRead({ownership:'suppressed'}),'fixed-v1',{presentation(){throw Error('must not call');}});
+ assert.deepEqual(await port.read('owner',receipt),{status:'not_requested'});
+ assert.ok(!sql.some(q=>q.includes('INSERT')||q.includes('UPDATE')||q.includes('DELETE')));
+});
+test('missing ownership remains unknown, never inferred legacy from missing G',async()=>{
+ const {createNarrativeV2Port}=await load('narrative-ownership-v2');
+ assert.deepEqual(await createNarrativeV2Port(fakeRead(null),'fixed-v1',{}).read('owner',receipt),{status:'ownership_unknown'});
+});
+test('managed declaration with missing generation raises integrity failure',async()=>{
+ const {createNarrativeV2Port}=await load('narrative-ownership-v2');
+ await assert.rejects(createNarrativeV2Port(fakeRead({ownership:'managed',generation_id:'missing'}),'fixed-v1',{}).read('owner',receipt),/MANAGED_INTEGRITY_FAILURE/);
+});
+test('managed pending and running are read-only, cancellation cannot turn them failed',async()=>{
+ const {createNarrativeV2Port}=await load('narrative-ownership-v2');
+ for(const state of ['pending','running']){
+  const controller=new AbortController();controller.abort();
+  const port=createNarrativeV2Port(fakeRead({ownership:'managed',generation_id:'g'},{id:'g',rendererVersion:'fixed-v1'}),'fixed-v1',
+   {presentation:async()=>({generation:state,source:null})});
+  assert.deepEqual(await port.read('owner',receipt,controller.signal),{status:state,wait:'cancelled'});
+ }
+});
+test('registration false records only ownership on caller client',async()=>{
+ const {createNarrativeV2Port}=await load('narrative-ownership-v2');const queries=[];
+ const c={async query(q){queries.push(q);return{rowCount:1,rows:[{receipt_sha:sha}]};}};
+ await createNarrativeV2Port({},'fixed-v1',{}).register(c,{ownerId:'owner',receipt,save:{schemaVersion:1,saveId:receipt.saveId},requestNarrative:false});
+ assert.equal(queries.filter(q=>q.includes('INSERT INTO narrative_receipt_ownership')).length,1);
+ assert.ok(!queries.some(q=>/INSERT INTO narrative_(context|generation|outbox|attempt|sources)/.test(q)));
+ assert.ok(!queries.some(q=>/COMMIT|BEGIN/.test(q)));
+});
+test('explicit failed generation cannot acquire a new attempt',async()=>{
+ const {NarrativePublicationRepository}=await load('narrative-publication-repository');const queries=[];
+ const c={release(){},async query(q){queries.push(q);return q.includes('SELECT g.*,c.context')?{rows:[{id:'g',state:'failed'}],rowCount:1}:{rows:[{id:'ok'}],rowCount:1};}};
+ assert.equal(await new NarrativePublicationRepository({connect:async()=>c}).claim('owner','save','key'),null);
+ assert.ok(!queries.some(q=>q.includes('INSERT INTO narrative_attempts')));
+});
+test('active lease is not stolen, exhausted recovery becomes terminal',async()=>{
+ const {NarrativePublicationRepository}=await load('narrative-publication-repository');
+ const context={format:'authority-context-v1',policySurface:'p5-narrative',rendererVersion:'fixed-v1',hints:{},receipt};
+ // The fixture receipt is parsed by real contracts. Supply one accepted event for schema validation.
+ context.receipt={...receipt,decision:{status:'accepted',nextRevision:1,events:[{id:'22222222-2222-4222-8222-222222222222',saveId:'fixture-save',type:'fixture',source:'RULES',ruleVersion:'fixture',beforeRevision:0,afterRevision:1,occurredAt:new Date().toISOString(),payload:{}}]}};
+ for(const live of [true,false]){
+  const queries=[];const c={release(){},async query(q){queries.push(q);
+   if(q.includes('SELECT g.*,c.context'))return{rows:[{id:'g',state:'running',lease_epoch:3,context,intact:true}],rowCount:1};
+   if(q.includes("SELECT id FROM narrative_attempts"))return{rows:live?[{id:'active'}]:[],rowCount:live?1:0};
+   return{rows:[{id:'ok'}],rowCount:1};}};
+  assert.equal(await new NarrativePublicationRepository({connect:async()=>c},undefined,{maxAttempts:3,leaseMs:150000}).claim('owner','save','key'),null);
+  assert.ok(!queries.some(q=>q.includes('INSERT INTO narrative_attempts')));
+  assert.equal(queries.some(q=>q.includes("SET state='failed'")),!live);
+ }
+});
+test('worker execution deadline fails task without late publish',async()=>{
+ const {NarrativeOutboxWorker}=await load('narrative-outbox-worker');let failures=0,publishes=0;
+ const repo={presentation:async()=>({publication:'pending',source:null}),claim:async()=>({context:{rendererVersion:'fixed-v1',receipt,hints:{}}}),
+  fail:async()=>{failures++;},publish:async()=>{publishes++;}};
+ await assert.rejects(new NarrativeOutboxWorker(repo,new Map([['fixed-v1',()=>new Promise(()=>{})]]),5).run('o','s','k'),/EXECUTION_TIMEOUT/);
+ assert.equal(failures,1);assert.equal(publishes,0);
+});
