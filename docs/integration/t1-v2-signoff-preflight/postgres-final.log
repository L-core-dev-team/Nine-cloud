	-- Install in a single transaction, after ingress freeze and all old workers are stopped.
	-- Serialize the check against old G writes. Never strand an unfinished 0022 task behind
	-- the new managed-declaration UPDATE trigger, or manufacture a V2 declaration for it.
	LOCK TABLE public.narrative_generation_requests IN SHARE MODE;
	DO $$ BEGIN
	 IF EXISTS(SELECT 1 FROM public.narrative_generation_requests WHERE state IN ('pending','running'))
