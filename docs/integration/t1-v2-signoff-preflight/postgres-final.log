	   'jiuxiao_narrative_schema_owner','jiuxiao_narrative_runtime'] LOOP
	  IF NOT EXISTS(SELECT 1 FROM pg_roles WHERE rolname=role_name AND NOT rolcanlogin AND NOT rolsuper
